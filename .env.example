# DashScope API Key (阿里云百炼 / 千问)
# 获取：https://dashscope.console.aliyun.com/ → API-KEY 管理

DASHSCOPE_API_KEY=your-dashscope-api-key-here

# 主链路 LLM（RAG Agent、诊断路由、行动生成、晨报）
# 推荐 qwen3.7-max-2026-05-17：Tool 调用与复杂归因能力最强
LLM_MODEL=qwen3.7-max-2026-05-17

# Embedding（向量检索，injest / Chroma / RAG Tool）
EMBEDDING_MODEL=text-embedding-v3

# RAG Tool 检索参数（统一由 VectorStoreConfig 读取）
RAG_TOOL_TOP_K=1
RAG_SCORE_THRESHOLD=0.25
RAG_CHROMA_FETCH_K=24

# 可选：LLM 温度（默认 0）
# LLM_TEMPERATURE=0

# 使用说明：
# 1. 复制此文件为 .env（.env 已在 .gitignore 中）
# 2. 填入真实 API Key 与模型名
